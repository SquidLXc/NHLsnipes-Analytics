# Development environment configuration
NODE_ENV=development

# Server port
PORT=8080

# Base path for API
BASE_PATH=/

# Serve frontend from API server in production
SERVE_FRONTEND=false

# NHL API configuration
NHLSNIPES_NHL_API_BASE_URL=https://api-web.nhle.com/v1
NHLSNIPES_SEASON_START_DATE=2026-09-29
NHLSNIPES_INCLUDE_PRESEASON=true

# Optional: PostgreSQL database (not required for basic operation)
# DATABASE_URL=

# Optional: The Odds API key for sportsbook lines
# ODDS_API_KEY=

# Optional: Sync interval in milliseconds (15 minutes = 900000)
# NHLSNIPES_SYNC_INTERVAL_MS=900000

# Optional: Database pool settings
# PGPOOL_MAX=10

# Logging
LOG_LEVEL=info
