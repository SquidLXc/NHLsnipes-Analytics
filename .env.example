# PostgreSQL is required when persistence-backed ingestion and audit storage are enabled.
DATABASE_URL=

# URL for a permitted/licensed NHL data adapter that follows the NHLsnipes provider contract.
# Do not point this at an endpoint whose terms prohibit commercial use or redistribution.
NHLSNIPES_PROVIDER_URL=

# Concrete provider used by the app. No API key is required for these public NHL Web API endpoints.
NHLSNIPES_NHL_API_BASE_URL=https://api-web.nhle.com/v1
# Optional licensed asset CDN/base path for provider references that are not absolute URLs.
NHLSNIPES_ASSET_BASE_URL=
# Do not expose upstream schedule records before the verified season start.
NHLSNIPES_SEASON_START_DATE=2026-09-29

# Optional approved odds adapter. Sportsbook lines stay unavailable when unset.
NHLSNIPES_ODDS_PROVIDER_URL=

# Optional runtime controls.
LOG_LEVEL=info
NODE_ENV=development