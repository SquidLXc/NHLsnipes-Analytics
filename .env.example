# PostgreSQL is required for persistence, scheduled ingestion, and health checks.
DATABASE_URL=

# Concrete NHL schedule/standings/roster provider used by the app.
# Confirm the provider's terms permit the intended public/commercial use.
NHLSNIPES_NHL_API_BASE_URL=https://api-web.nhle.com/v1
# Optional licensed asset CDN/base path for provider references that are not absolute URLs.
NHLSNIPES_ASSET_BASE_URL=
# Do not expose upstream schedule records before the verified season start.
NHLSNIPES_SEASON_START_DATE=2026-09-29

# Server-only secret from The Odds API. Sportsbook lines stay unavailable when unset.
ODDS_API_KEY=

# Production server/runtime settings.
PORT=8080
BASE_PATH=/
SERVE_FRONTEND=true
NHLSNIPES_SYNC_INTERVAL_MS=900000
PGPOOL_MAX=10

# Optional runtime control.
LOG_LEVEL=info
NODE_ENV=development